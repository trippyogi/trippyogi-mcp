{
  "name": "trippyogi-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "An MCP server that lets you fact-check my resume.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate:site": "tsx src/generate/site.ts",
    "build": "npm run generate:site && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trippyogi/trippyogi-mcp.git"
  },
  "keywords": [
    "mcp",
    "resume",
    "verification"
  ],
  "author": "Jeremy McKeehen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trippyogi/trippyogi-mcp/issues"
  },
  "homepage": "https://github.com/trippyogi/trippyogi-mcp#readme",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
